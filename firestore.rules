rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives & Security Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'ashokraj7676767676@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUsernameHandle(val) {
      return val is string && val.size() >= 3 && val.size() <= 24 && val.matches('^[a-z0-9]+$');
    }

    function isValidWorkspaceState(ws) {
      return ws is map &&
        ws.keys().hasOnly(['lastTab', 'lastGamingSubTab', 'lastDashboardTab', 'lastRoomAddress', 'updatedAt']) &&
        (!('lastTab' in ws) || isValidString(ws.lastTab, 0, 48)) &&
        (!('lastGamingSubTab' in ws) || isValidString(ws.lastGamingSubTab, 0, 48)) &&
        (!('lastDashboardTab' in ws) || isValidString(ws.lastDashboardTab, 0, 48)) &&
        (!('lastRoomAddress' in ws) || isValidString(ws.lastRoomAddress, 0, 24)) &&
        (!('updatedAt' in ws) || isValidString(ws.updatedAt, 0, 64));
    }

    function isValidShaKey(val) {
      return val is string && val.size() >= 10 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'authUid', 'fullName', 'phone', 'email', 'status', 'role', 'createdAt']) &&
        data.keys().hasOnly([
          'userId', 'authUid', 'username', 'fullName', 'phone', 'email', 'fullAddress',
          'paymentAddress', 'payoutUpiId', 'password', 'sponsorId', 'sponsorName',
          'chosenServiceCode', 'chosenServiceName', 'joiningFee', 'joiningDate',
          'paymentUtr', 'paymentScreenshot', 'status', 'accountType', 'balance', 'totalEarnings',
          'referralEarnings', 'totalWithdrawn', 'coins', 'charms',
          'gameLevel', 'gameXp', 'vipTier', 'unlockedFrames', 'frameType',
          'tasksCompletedCount', 'totalGamesPlayed', 'totalGamesWon', 'unlockedRooms', 'roomTheme',
          'clanName', 'avatar', 'coverPhoto', 'bio',
          'gender', 'location', 'friendsList', 'gamingId', 'personalRoomId',
          'roomAddress', 'todayActiveness', 'loginStreak', 'claimedDays',
          'lastDailyCheckInDate', 'workspaceState', 'registeredFromHost',
          'swiAppLink', 'swiAppNote', 'role', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.fullName, 1, 120) &&
        isValidString(data.phone, 6, 24) &&
        isValidString(data.email, 3, 150) &&
        data.status in ['pending', 'active', 'rejected'] &&
        data.role in ['member', 'admin'] &&
        isValidString(data.createdAt, 4, 64) &&
        (!('username' in data) || data.username == '' || isValidUsernameHandle(data.username)) &&
        (!('fullAddress' in data) || isValidString(data.fullAddress, 0, 300)) &&
        (!('paymentAddress' in data) || isValidString(data.paymentAddress, 0, 120)) &&
        (!('payoutUpiId' in data) || isValidString(data.payoutUpiId, 0, 120)) &&
        (!('password' in data) || isValidString(data.password, 0, 128)) &&
        (!('sponsorId' in data) || isValidString(data.sponsorId, 0, 64)) &&
        (!('sponsorName' in data) || isValidString(data.sponsorName, 0, 120)) &&
        (!('chosenServiceCode' in data) || isValidString(data.chosenServiceCode, 0, 24)) &&
        (!('chosenServiceName' in data) || isValidString(data.chosenServiceName, 0, 120)) &&
        (!('joiningFee' in data) || (data.joiningFee is number && data.joiningFee >= 0)) &&
        (!('joiningDate' in data) || isValidString(data.joiningDate, 0, 32)) &&
        (!('paymentUtr' in data) || isValidString(data.paymentUtr, 0, 64)) &&
        (!('paymentScreenshot' in data) || isValidString(data.paymentScreenshot, 0, 250000)) &&
        (!('accountType' in data) || data.accountType in ['business', 'gamer']) &&
        (!('balance' in data) || (data.balance is number && data.balance >= 0)) &&
        (!('totalEarnings' in data) || (data.totalEarnings is number && data.totalEarnings >= 0)) &&
        (!('referralEarnings' in data) || (data.referralEarnings is number && data.referralEarnings >= 0)) &&
        (!('totalWithdrawn' in data) || (data.totalWithdrawn is number && data.totalWithdrawn >= 0)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('charms' in data) || (data.charms is number && data.charms >= 0)) &&
        (!('gameLevel' in data) || (data.gameLevel is number && data.gameLevel >= 1)) &&
        (!('gameXp' in data) || (data.gameXp is number && data.gameXp >= 0)) &&
        (!('vipTier' in data) || data.vipTier in ['none', 'silver', 'gold', 'diamond']) &&
        (!('unlockedFrames' in data) || (data.unlockedFrames is list && data.unlockedFrames.size() >= 1 && data.unlockedFrames.size() <= 20 && data.unlockedFrames[0] is string)) &&
        (!('frameType' in data) || isValidString(data.frameType, 1, 64)) &&
        (!('tasksCompletedCount' in data) || (data.tasksCompletedCount is number && data.tasksCompletedCount >= 0)) &&
        (!('totalGamesPlayed' in data) || (data.totalGamesPlayed is number && data.totalGamesPlayed >= 0)) &&
        (!('totalGamesWon' in data) || (data.totalGamesWon is number && data.totalGamesWon >= 0)) &&
        (!('unlockedRooms' in data) || (data.unlockedRooms is list && data.unlockedRooms.size() <= 30 && (data.unlockedRooms.size() == 0 || data.unlockedRooms[0] is string))) &&
        (!('roomTheme' in data) || isValidString(data.roomTheme, 0, 64)) &&
        (!('clanName' in data) || isValidString(data.clanName, 0, 100)) &&
        (!('avatar' in data) || isValidString(data.avatar, 0, 500)) &&
        (!('coverPhoto' in data) || isValidString(data.coverPhoto, 0, 500)) &&
        (!('bio' in data) || isValidString(data.bio, 0, 240)) &&
        (!('gender' in data) || isValidString(data.gender, 0, 24)) &&
        (!('location' in data) || isValidString(data.location, 0, 100)) &&
        (!('friendsList' in data) || (data.friendsList is list && data.friendsList.size() <= 500 && (data.friendsList.size() == 0 || data.friendsList[0] is string))) &&
        (!('gamingId' in data) || isValidString(data.gamingId, 0, 64)) &&
        (!('personalRoomId' in data) || isValidString(data.personalRoomId, 0, 24)) &&
        (!('roomAddress' in data) || isValidString(data.roomAddress, 0, 24)) &&
        (!('todayActiveness' in data) || (data.todayActiveness is number && data.todayActiveness >= 0)) &&
        (!('loginStreak' in data) || (data.loginStreak is number && data.loginStreak >= 0)) &&
        (!('claimedDays' in data) || (data.claimedDays is list && data.claimedDays.size() <= 7)) &&
        (!('lastDailyCheckInDate' in data) || isValidString(data.lastDailyCheckInDate, 0, 32)) &&
        (!('workspaceState' in data) || isValidWorkspaceState(data.workspaceState)) &&
        (!('registeredFromHost' in data) || isValidString(data.registeredFromHost, 0, 128)) &&
        (!('swiAppLink' in data) || isValidString(data.swiAppLink, 0, 500)) &&
        (!('swiAppNote' in data) || isValidString(data.swiAppNote, 0, 500)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 4, 64));
    }

    function isValidCloudRegistration(data) {
      return data.keys().hasAll(['userId', 'fullName', 'phone', 'email', 'status', 'accountType', 'role', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'gamingId', 'username', 'fullName', 'phone', 'email', 'fullAddress',
          'paymentAddress', 'payoutUpiId', 'password', 'sponsorId', 'sponsorName',
          'chosenServiceCode', 'chosenServiceName', 'joiningFee', 'joiningDate',
          'paymentUtr', 'paymentScreenshot', 'status', 'accountType', 'balance', 'coins', 'charms',
          'gameLevel', 'vipTier', 'frameType', 'personalRoomId', 'roomAddress',
          'registeredFromHost', 'swiAppLink', 'swiAppNote', 'role', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidString(data.fullName, 1, 120) &&
        isValidString(data.phone, 6, 24) &&
        isValidString(data.email, 3, 150) &&
        data.status in ['pending', 'active', 'rejected'] &&
        data.accountType in ['business', 'gamer'] &&
        data.role == 'member' &&
        isValidString(data.createdAt, 4, 64) &&
        (!('id' in data) || isValidString(data.id, 1, 128)) &&
        (!('gamingId' in data) || isValidString(data.gamingId, 0, 64)) &&
        (!('username' in data) || data.username == '' || isValidUsernameHandle(data.username)) &&
        (!('fullAddress' in data) || isValidString(data.fullAddress, 0, 300)) &&
        (!('paymentAddress' in data) || isValidString(data.paymentAddress, 0, 120)) &&
        (!('payoutUpiId' in data) || isValidString(data.payoutUpiId, 0, 120)) &&
        (!('password' in data) || isValidString(data.password, 0, 128)) &&
        (!('sponsorId' in data) || isValidString(data.sponsorId, 0, 64)) &&
        (!('sponsorName' in data) || isValidString(data.sponsorName, 0, 120)) &&
        (!('chosenServiceCode' in data) || isValidString(data.chosenServiceCode, 0, 24)) &&
        (!('chosenServiceName' in data) || isValidString(data.chosenServiceName, 0, 120)) &&
        (!('joiningFee' in data) || (data.joiningFee is number && data.joiningFee >= 0)) &&
        (!('joiningDate' in data) || isValidString(data.joiningDate, 0, 32)) &&
        (!('paymentUtr' in data) || isValidString(data.paymentUtr, 0, 64)) &&
        (!('paymentScreenshot' in data) || isValidString(data.paymentScreenshot, 0, 250000)) &&
        (!('balance' in data) || (data.balance is number && data.balance >= 0)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('charms' in data) || (data.charms is number && data.charms >= 0)) &&
        (!('gameLevel' in data) || (data.gameLevel is number && data.gameLevel >= 1)) &&
        (!('vipTier' in data) || data.vipTier in ['none', 'silver', 'gold', 'diamond']) &&
        (!('frameType' in data) || isValidString(data.frameType, 0, 64)) &&
        (!('personalRoomId' in data) || isValidString(data.personalRoomId, 0, 24)) &&
        (!('roomAddress' in data) || isValidString(data.roomAddress, 0, 24)) &&
        (!('registeredFromHost' in data) || isValidString(data.registeredFromHost, 0, 128)) &&
        (!('swiAppLink' in data) || isValidString(data.swiAppLink, 0, 500)) &&
        (!('swiAppNote' in data) || isValidString(data.swiAppNote, 0, 500)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 4, 64));
    }

    function isValidIdentityLock(data) {
      return data.keys().hasAll(['lockKey', 'lockType', 'userId', 'createdAt']) &&
        data.keys().hasOnly(['lockKey', 'lockType', 'userId', 'gamingId', 'accountType', 'chosenServiceCode', 'createdAt']) &&
        isValidShaKey(data.lockKey) &&
        data.lockType in ['phone', 'email', 'username', 'userId', 'gamingId', 'roomAddress'] &&
        isValidId(data.userId) &&
        isValidString(data.createdAt, 4, 64) &&
        (!('gamingId' in data) || isValidString(data.gamingId, 0, 64)) &&
        (!('accountType' in data) || data.accountType in ['business', 'gamer']) &&
        (!('chosenServiceCode' in data) || isValidString(data.chosenServiceCode, 0, 24));
    }

    function isValidDeviceVault(data) {
      return data.keys().hasAll(['vaultKey', 'userId', 'updatedAt']) &&
        data.keys().hasOnly([
          'vaultKey', 'isPointer', 'pointerTargetKey', 'userId', 'gamingId',
          'personalRoomId', 'roomAddress', 'sponsorId', 'sponsorName', 'username',
          'fullName', 'phone', 'email', 'fullAddress', 'paymentAddress', 'payoutUpiId',
          'chosenServiceCode', 'chosenServiceName', 'joiningFee', 'joiningDate', 'paymentUtr',
          'status', 'accountType', 'role', 'balance', 'totalEarnings', 'referralEarnings',
          'totalWithdrawn', 'coins', 'charms', 'gameLevel', 'gameXp', 'vipTier', 'frameType',
          'unlockedFrames', 'tasksCompletedCount', 'totalGamesPlayed', 'totalGamesWon',
          'unlockedRooms', 'roomTheme', 'clanName', 'avatar', 'coverPhoto', 'bio',
          'gender', 'location', 'friendsList', 'todayActiveness', 'loginStreak', 'claimedDays',
          'lastDailyCheckInDate', 'workspaceState', 'registeredFromHost', 'swiAppLink',
          'swiAppNote', 'password', 'createdAt', 'updatedAt'
        ]) &&
        isValidShaKey(data.vaultKey) &&
        isValidId(data.userId) &&
        isValidString(data.updatedAt, 4, 64) &&
        (!('isPointer' in data) || data.isPointer is bool) &&
        (!('pointerTargetKey' in data) || isValidString(data.pointerTargetKey, 0, 128)) &&
        (!('gamingId' in data) || isValidString(data.gamingId, 0, 64)) &&
        (!('personalRoomId' in data) || isValidString(data.personalRoomId, 0, 24)) &&
        (!('roomAddress' in data) || isValidString(data.roomAddress, 0, 24)) &&
        (!('sponsorId' in data) || isValidString(data.sponsorId, 0, 64)) &&
        (!('sponsorName' in data) || isValidString(data.sponsorName, 0, 120)) &&
        (!('username' in data) || data.username == '' || isValidUsernameHandle(data.username)) &&
        (!('fullName' in data) || isValidString(data.fullName, 0, 120)) &&
        (!('phone' in data) || isValidString(data.phone, 0, 24)) &&
        (!('email' in data) || isValidString(data.email, 0, 150)) &&
        (!('fullAddress' in data) || isValidString(data.fullAddress, 0, 300)) &&
        (!('paymentAddress' in data) || isValidString(data.paymentAddress, 0, 120)) &&
        (!('payoutUpiId' in data) || isValidString(data.payoutUpiId, 0, 120)) &&
        (!('chosenServiceCode' in data) || isValidString(data.chosenServiceCode, 0, 24)) &&
        (!('chosenServiceName' in data) || isValidString(data.chosenServiceName, 0, 120)) &&
        (!('joiningFee' in data) || (data.joiningFee is number && data.joiningFee >= 0)) &&
        (!('joiningDate' in data) || isValidString(data.joiningDate, 0, 32)) &&
        (!('paymentUtr' in data) || isValidString(data.paymentUtr, 0, 64)) &&
        (!('status' in data) || data.status in ['pending', 'active', 'rejected']) &&
        (!('accountType' in data) || data.accountType in ['business', 'gamer']) &&
        (!('role' in data) || data.role in ['member', 'admin']) &&
        (!('balance' in data) || (data.balance is number && data.balance >= 0)) &&
        (!('totalEarnings' in data) || (data.totalEarnings is number && data.totalEarnings >= 0)) &&
        (!('referralEarnings' in data) || (data.referralEarnings is number && data.referralEarnings >= 0)) &&
        (!('totalWithdrawn' in data) || (data.totalWithdrawn is number && data.totalWithdrawn >= 0)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('charms' in data) || (data.charms is number && data.charms >= 0)) &&
        (!('gameLevel' in data) || (data.gameLevel is number && data.gameLevel >= 1)) &&
        (!('gameXp' in data) || (data.gameXp is number && data.gameXp >= 0)) &&
        (!('vipTier' in data) || data.vipTier in ['none', 'silver', 'gold', 'diamond']) &&
        (!('frameType' in data) || isValidString(data.frameType, 0, 64)) &&
        (!('unlockedFrames' in data) || (data.unlockedFrames is list && data.unlockedFrames.size() <= 20 && (data.unlockedFrames.size() == 0 || data.unlockedFrames[0] is string))) &&
        (!('tasksCompletedCount' in data) || (data.tasksCompletedCount is number && data.tasksCompletedCount >= 0)) &&
        (!('totalGamesPlayed' in data) || (data.totalGamesPlayed is number && data.totalGamesPlayed >= 0)) &&
        (!('totalGamesWon' in data) || (data.totalGamesWon is number && data.totalGamesWon >= 0)) &&
        (!('unlockedRooms' in data) || (data.unlockedRooms is list && data.unlockedRooms.size() <= 30 && (data.unlockedRooms.size() == 0 || data.unlockedRooms[0] is string))) &&
        (!('roomTheme' in data) || isValidString(data.roomTheme, 0, 64)) &&
        (!('clanName' in data) || isValidString(data.clanName, 0, 100)) &&
        (!('avatar' in data) || isValidString(data.avatar, 0, 500)) &&
        (!('coverPhoto' in data) || isValidString(data.coverPhoto, 0, 500)) &&
        (!('bio' in data) || isValidString(data.bio, 0, 240)) &&
        (!('gender' in data) || isValidString(data.gender, 0, 24)) &&
        (!('location' in data) || isValidString(data.location, 0, 100)) &&
        (!('friendsList' in data) || (data.friendsList is list && data.friendsList.size() <= 500 && (data.friendsList.size() == 0 || data.friendsList[0] is string))) &&
        (!('todayActiveness' in data) || (data.todayActiveness is number && data.todayActiveness >= 0)) &&
        (!('loginStreak' in data) || (data.loginStreak is number && data.loginStreak >= 0)) &&
        (!('claimedDays' in data) || (data.claimedDays is list && data.claimedDays.size() <= 7)) &&
        (!('lastDailyCheckInDate' in data) || isValidString(data.lastDailyCheckInDate, 0, 32)) &&
        (!('workspaceState' in data) || isValidWorkspaceState(data.workspaceState)) &&
        (!('registeredFromHost' in data) || isValidString(data.registeredFromHost, 0, 128)) &&
        (!('swiAppLink' in data) || isValidString(data.swiAppLink, 0, 500)) &&
        (!('swiAppNote' in data) || isValidString(data.swiAppNote, 0, 500)) &&
        (!('password' in data) || isValidString(data.password, 0, 128)) &&
        (!('createdAt' in data) || isValidString(data.createdAt, 0, 64));
    }

    function isValidCloudPlanUpgrade(data) {
      return data.keys().hasAll(['id', 'userId', 'targetServiceCode', 'upgradeFee', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'userName', 'fromAccountType', 'upgradeType',
          'fromServiceCode', 'fromFee', 'targetServiceCode', 'targetServiceName',
          'upgradeFee', 'paymentUtr', 'paymentScreenshot', 'status', 'createdAt', 'processedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.targetServiceCode, 1, 24) &&
        data.upgradeFee is number && data.upgradeFee >= 0 &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isValidString(data.createdAt, 4, 64) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('fromAccountType' in data) || data.fromAccountType in ['business', 'gamer']) &&
        (!('upgradeType' in data) || data.upgradeType in ['plan_upgrade', 'gamer_to_business']) &&
        (!('fromServiceCode' in data) || isValidString(data.fromServiceCode, 0, 24)) &&
        (!('fromFee' in data) || (data.fromFee is number && data.fromFee >= 0)) &&
        (!('targetServiceName' in data) || isValidString(data.targetServiceName, 0, 120)) &&
        (!('paymentUtr' in data) || isValidString(data.paymentUtr, 0, 64)) &&
        (!('paymentScreenshot' in data) || isValidString(data.paymentScreenshot, 0, 250000)) &&
        (!('processedAt' in data) || isValidString(data.processedAt, 0, 64));
    }

    function isValidPlatformConfig(data) {
      return data.keys().hasAll(['configId', 'updatedAt']) &&
        data.keys().hasOnly(['configId', 'settings', 'services', 'updatedAt', 'updatedBy']) &&
        isValidId(data.configId) &&
        isValidString(data.updatedAt, 4, 64) &&
        (!('settings' in data) || data.settings is map) &&
        (!('services' in data) || (data.services is list && data.services.size() <= 40 && (data.services.size() == 0 || data.services[0] is map))) &&
        (!('updatedBy' in data) || isValidString(data.updatedBy, 0, 150));
    }

    function isValidPublicProfile(data) {
      return data.keys().hasAll(['userId', 'authUid', 'fullName', 'isPublic']) &&
        data.keys().hasOnly([
          'userId', 'authUid', 'username', 'fullName', 'avatar', 'coverPhoto',
          'bio', 'gender', 'location', 'frameType', 'vipTier',
          'gameLevel', 'gameXp', 'charms', 'coins', 'clanName', 'personalRoomId', 'roomAddress',
          'friendsCount', 'isPublic', 'updatedAt'
        ]) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.fullName, 1, 120) &&
        data.isPublic is bool &&
        (!('username' in data) || data.username == '' || isValidUsernameHandle(data.username)) &&
        (!('avatar' in data) || isValidString(data.avatar, 0, 500)) &&
        (!('coverPhoto' in data) || isValidString(data.coverPhoto, 0, 500)) &&
        (!('bio' in data) || isValidString(data.bio, 0, 240)) &&
        (!('gender' in data) || isValidString(data.gender, 0, 24)) &&
        (!('location' in data) || isValidString(data.location, 0, 100)) &&
        (!('frameType' in data) || isValidString(data.frameType, 1, 64)) &&
        (!('vipTier' in data) || data.vipTier in ['none', 'silver', 'gold', 'diamond']) &&
        (!('gameLevel' in data) || (data.gameLevel is number && data.gameLevel >= 1)) &&
        (!('gameXp' in data) || (data.gameXp is number && data.gameXp >= 0)) &&
        (!('charms' in data) || (data.charms is number && data.charms >= 0)) &&
        (!('coins' in data) || (data.coins is number && data.coins >= 0)) &&
        (!('clanName' in data) || isValidString(data.clanName, 0, 100)) &&
        (!('personalRoomId' in data) || isValidString(data.personalRoomId, 0, 24)) &&
        (!('roomAddress' in data) || isValidString(data.roomAddress, 0, 24)) &&
        (!('friendsCount' in data) || (data.friendsCount is number && data.friendsCount >= 0)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 4, 64));
    }

    function isValidUsernameReservation(data) {
      return data.keys().hasAll(['username', 'userId', 'authUid', 'createdAt']) &&
        data.keys().hasOnly(['username', 'userId', 'authUid', 'createdAt']) &&
        isValidUsernameHandle(data.username) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.createdAt, 4, 64);
    }

    function isValidReferral(data) {
      return data.keys().hasAll(['id', 'sponsorUserId', 'downlineUserId', 'commissionAmount', 'status', 'authUid']) &&
        data.keys().hasOnly([
          'id', 'sponsorUserId', 'downlineUserId', 'downlineName',
          'serviceCode', 'joiningFee', 'commissionAmount', 'status', 'authUid', 'date'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.sponsorUserId) &&
        isValidId(data.downlineUserId) &&
        data.commissionAmount is number && data.commissionAmount >= 0 &&
        data.status in ['credited', 'pending', 'rejected'] &&
        isValidString(data.authUid, 1, 128) &&
        (!('downlineName' in data) || isValidString(data.downlineName, 0, 120)) &&
        (!('serviceCode' in data) || isValidString(data.serviceCode, 0, 24)) &&
        (!('joiningFee' in data) || (data.joiningFee is number && data.joiningFee >= 0)) &&
        (!('date' in data) || isValidString(data.date, 0, 64));
    }

    function isValidPayout(data) {
      return data.keys().hasAll(['id', 'userId', 'authUid', 'amount', 'payoutAddress', 'status', 'requestDate']) &&
        data.keys().hasOnly([
          'id', 'userId', 'authUid', 'userName', 'amount',
          'payoutAddress', 'status', 'requestDate', 'transactionRef'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        data.amount is number && data.amount >= 10 &&
        isValidString(data.payoutAddress, 3, 120) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        isValidString(data.requestDate, 4, 64) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('transactionRef' in data) || isValidString(data.transactionRef, 0, 128));
    }

    function isValidGiftCardRedemption(data) {
      return data.keys().hasAll(['id', 'catalogId', 'userId', 'authUid', 'coinsSpent', 'status', 'requestedAt']) &&
        data.keys().hasOnly([
          'id', 'catalogId', 'brand', 'title', 'denomination', 'coinsSpent',
          'userId', 'authUid', 'userName', 'status', 'voucherCode', 'voucherPin',
          'rejectionReason', 'requestedAt', 'fulfilledAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.catalogId) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        data.coinsSpent is number && data.coinsSpent >= 10 &&
        data.status in ['pending_fulfillment', 'fulfilled', 'rejected'] &&
        isValidString(data.requestedAt, 4, 64) &&
        (!('brand' in data) || isValidString(data.brand, 0, 64)) &&
        (!('title' in data) || isValidString(data.title, 0, 120)) &&
        (!('denomination' in data) || (data.denomination is number && data.denomination >= 0)) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('voucherCode' in data) || isValidString(data.voucherCode, 0, 128)) &&
        (!('voucherPin' in data) || isValidString(data.voucherPin, 0, 64)) &&
        (!('rejectionReason' in data) || isValidString(data.rejectionReason, 0, 200)) &&
        (!('fulfilledAt' in data) || isValidString(data.fulfilledAt, 0, 64));
    }

    function isValidComplaint(data) {
      return data.keys().hasAll(['id', 'userId', 'authUid', 'category', 'subject', 'description', 'status', 'createdAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'authUid', 'userName', 'category', 'subject',
          'description', 'status', 'adminResponse', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.category, 1, 64) &&
        isValidString(data.subject, 1, 160) &&
        isValidString(data.description, 1, 2000) &&
        data.status in ['open', 'in_progress', 'resolved', 'rejected'] &&
        isValidString(data.createdAt, 4, 64) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('adminResponse' in data) || isValidString(data.adminResponse, 0, 1000)) &&
        (!('updatedAt' in data) || isValidString(data.updatedAt, 4, 64));
    }

    function isValidGamePlay(data) {
      return data.keys().hasAll(['id', 'userId', 'authUid', 'gameName', 'betCoins', 'wonCoins', 'result', 'playedAt']) &&
        data.keys().hasOnly([
          'id', 'userId', 'authUid', 'userName', 'gameId', 'gameName',
          'betCoins', 'wonCoins', 'netChange', 'result', 'playedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.gameName, 1, 100) &&
        data.betCoins is number && data.betCoins >= 0 &&
        data.wonCoins is number && data.wonCoins >= 0 &&
        data.result in ['win', 'loss', 'draw'] &&
        isValidString(data.playedAt, 4, 64) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('gameId' in data) || isValidString(data.gameId, 0, 64)) &&
        (!('netChange' in data) || data.netChange is number);
    }

    function isValidCoinTransaction(data) {
      return data.keys().hasAll(['id', 'userId', 'authUid', 'type', 'amount', 'balanceBefore', 'balanceAfter', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'userId', 'authUid', 'userName', 'type', 'category',
          'categoryLabel', 'amount', 'balanceBefore', 'balanceAfter', 'description', 'timestamp'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        data.type in ['credit', 'debit'] &&
        data.amount is number && data.amount >= 0 &&
        data.balanceBefore is number && data.balanceBefore >= 0 &&
        data.balanceAfter is number && data.balanceAfter >= 0 &&
        isValidString(data.timestamp, 4, 64) &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('category' in data) || isValidString(data.category, 0, 64)) &&
        (!('categoryLabel' in data) || isValidString(data.categoryLabel, 0, 120)) &&
        (!('description' in data) || isValidString(data.description, 0, 400));
    }

    function isValidActivitySession(data) {
      return data.keys().hasAll(['id', 'userId', 'authUid', 'sessionStart', 'lastHeartbeat', 'status']) &&
        data.keys().hasOnly([
          'id', 'userId', 'authUid', 'userName', 'sessionStart',
          'lastHeartbeat', 'durationMinutes', 'deviceType', 'status'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.userId) &&
        isValidString(data.authUid, 1, 128) &&
        isValidString(data.sessionStart, 4, 64) &&
        isValidString(data.lastHeartbeat, 4, 64) &&
        data.status in ['online', 'offline'] &&
        (!('userName' in data) || isValidString(data.userName, 0, 120)) &&
        (!('durationMinutes' in data) || (data.durationMinutes is number && data.durationMinutes >= 0)) &&
        (!('deviceType' in data) || isValidString(data.deviceType, 0, 32));
    }

    // 2. Admins Registry
    match /admins/{uid} {
      allow get: if isVerified() && isValidId(uid) && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // 3. Private User Profiles (PII Strictly Isolated to Owner or Admin)
    match /users/{userId} {
      allow get: if isVerified() && isValidId(userId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && (
        (incoming().authUid == request.auth.uid && incoming().role == 'member' && incoming().status == 'pending' && incoming().coins == 0 && incoming().balance == 0) ||
        isAdmin()
      );
      allow update: if isVerified() && isValidId(userId) && isValidUserProfile(incoming()) && (
        (
          isAdmin() &&
          incoming().userId == existing().userId &&
          (!('sponsorId' in existing()) || existing().sponsorId == '' || incoming().sponsorId == existing().sponsorId) &&
          (!('personalRoomId' in existing()) || existing().personalRoomId == '' || incoming().personalRoomId == existing().personalRoomId) &&
          (!('roomAddress' in existing()) || existing().roomAddress == '' || incoming().roomAddress == existing().roomAddress) &&
          (!('gamingId' in existing()) || existing().gamingId == '' || incoming().gamingId == existing().gamingId)
        ) ||
        (
          existing().authUid == request.auth.uid &&
          incoming().authUid == existing().authUid &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          (!('sponsorId' in existing()) || incoming().sponsorId == existing().sponsorId) &&
          (!('sponsorName' in existing()) || incoming().sponsorName == existing().sponsorName) &&
          (!('personalRoomId' in existing()) || existing().personalRoomId == '' || incoming().personalRoomId == existing().personalRoomId) &&
          (!('roomAddress' in existing()) || existing().roomAddress == '' || incoming().roomAddress == existing().roomAddress) &&
          (!('gamingId' in existing()) || existing().gamingId == '' || incoming().gamingId == existing().gamingId) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'fullName', 'fullAddress', 'paymentAddress', 'payoutUpiId',
            'avatar', 'coverPhoto', 'bio', 'gender', 'location', 'friendsList',
            'clanName', 'accountType', 'workspaceState', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    // 3b. Cross-Origin Registration Sync Intake (Write-Only Create, Admin-Only Read/Manage)
    match /cloud_registrations/{regId} {
      allow get: if isAdmin() && isValidId(regId);
      allow list: if isAdmin();
      allow create: if isValidId(regId) && isValidCloudRegistration(incoming()) && incoming().userId == regId;
      allow update: if isAdmin() && isValidId(regId) && isValidCloudRegistration(incoming());
      allow delete: if false;
    }

    // 3c. Zero-PII Identity Uniqueness Locks (Global Duplicate Prevention Across All Domains)
    match /identity_locks/{lockKey} {
      allow get: if isValidShaKey(lockKey);
      allow list: if false;
      allow create: if isValidShaKey(lockKey) &&
        isValidIdentityLock(incoming()) &&
        incoming().lockKey == lockKey &&
        !exists(/databases/$(database)/documents/identity_locks/$(lockKey));
      allow update, delete: if isAdmin();
    }

    // 3d. Credential-Keyed Cross-Device Sync Vault (SHA-256 Keyed, Zero Enumeration)
    match /device_sync_vault/{vaultKey} {
      allow get: if isValidShaKey(vaultKey);
      allow list: if false;
      allow create: if isValidShaKey(vaultKey) &&
        isValidDeviceVault(incoming()) &&
        incoming().vaultKey == vaultKey &&
        !exists(/databases/$(database)/documents/device_sync_vault/$(vaultKey));
      allow update: if isValidShaKey(vaultKey) && isValidDeviceVault(incoming()) && (
        isAdmin() || (
          incoming().vaultKey == existing().vaultKey &&
          incoming().userId == existing().userId &&
          (!('role' in existing()) || incoming().role == existing().role) &&
          (!('sponsorId' in existing()) || existing().sponsorId == '' || incoming().sponsorId == existing().sponsorId) &&
          (!('personalRoomId' in existing()) || existing().personalRoomId == '' || incoming().personalRoomId == existing().personalRoomId) &&
          (!('roomAddress' in existing()) || existing().roomAddress == '' || incoming().roomAddress == existing().roomAddress) &&
          (!('gamingId' in existing()) || existing().gamingId == '' || incoming().gamingId == existing().gamingId) &&
          (!('status' in existing()) || existing().status == 'active' || incoming().status == existing().status)
        )
      );
      allow delete: if false;
    }

    // 3e. Cross-Origin Plan Upgrade & Gaming-to-Income Queue (Admin Managed)
    match /cloud_plan_upgrades/{upgradeId} {
      allow get: if isAdmin() && isValidId(upgradeId);
      allow list: if isAdmin();
      allow create: if isValidId(upgradeId) &&
        isValidCloudPlanUpgrade(incoming()) &&
        incoming().id == upgradeId &&
        incoming().status == 'pending';
      allow update: if isAdmin() && isValidId(upgradeId) && isValidCloudPlanUpgrade(incoming());
      allow delete: if false;
    }

    // 3f. Global Platform Config (UPI, QR, Welcome Popup & Services Catalog - Admin Controlled)
    match /platform_config/{configId} {
      allow get: if isValidId(configId);
      allow list: if false;
      allow create, update: if isAdmin() &&
        isValidId(configId) &&
        isValidPlatformConfig(incoming()) &&
        incoming().configId == configId;
      allow delete: if false;
    }

    // 4. Public Gaming/Leaderboard Profiles (Zero PII)
    match /public_profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn() && existing().isPublic == true;
      allow create: if isVerified() && isValidId(userId) && isValidPublicProfile(incoming()) && (
        incoming().authUid == request.auth.uid || isAdmin()
      );
      allow update: if isVerified() && isValidId(userId) && isValidPublicProfile(incoming()) && (
        isAdmin() ||
        (
          existing().authUid == request.auth.uid &&
          incoming().authUid == existing().authUid &&
          incoming().userId == existing().userId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'fullName', 'avatar', 'coverPhoto', 'bio', 'gender', 'location',
            'friendsCount', 'clanName', 'isPublic', 'updatedAt'
          ])
        )
      );
      allow delete: if false;
    }

    // 4b. Unique Username Handle Reservations (Atomic Duplicate Prevention)
    match /usernames/{username} {
      allow get: if isSignedIn() && isValidUsernameHandle(username);
      allow list: if false;
      allow create: if isVerified() && isValidUsernameHandle(username) && isValidUsernameReservation(incoming()) &&
        incoming().username == username &&
        incoming().authUid == request.auth.uid &&
        !exists(/databases/$(database)/documents/usernames/$(username));
      allow update: if false;
      allow delete: if isVerified() && isValidUsernameHandle(username) && (
        existing().authUid == request.auth.uid || isAdmin()
      );
    }

    // 5. Referrals Ledger
    match /referrals/{referralId} {
      allow get: if isVerified() && isValidId(referralId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(referralId) && isValidReferral(incoming());
      allow update: if isAdmin() && isValidId(referralId) && isValidReferral(incoming()) && (
        existing().status == 'pending' || isAdmin()
      );
      allow delete: if false;
    }

    // 6. Payouts Escrow Collection
    match /payouts/{payoutId} {
      allow get: if isVerified() && isValidId(payoutId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(payoutId) && isValidPayout(incoming()) && (
        (incoming().authUid == request.auth.uid && incoming().status == 'pending') || isAdmin()
      );
      allow update: if isAdmin() && isValidId(payoutId) && isValidPayout(incoming()) && (
        existing().status == 'pending' &&
        incoming().authUid == existing().authUid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'transactionRef'])
      );
      allow delete: if false;
    }

    // 7. Gift Card Redemptions Collection
    match /gift_card_redemptions/{redemptionId} {
      allow get: if isVerified() && isValidId(redemptionId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(redemptionId) && isValidGiftCardRedemption(incoming()) && (
        (incoming().authUid == request.auth.uid && incoming().status == 'pending_fulfillment') || isAdmin()
      );
      allow update: if isAdmin() && isValidId(redemptionId) && isValidGiftCardRedemption(incoming()) && (
        existing().status == 'pending_fulfillment' &&
        incoming().authUid == existing().authUid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'voucherCode', 'voucherPin', 'rejectionReason', 'fulfilledAt'
        ])
      );
      allow delete: if false;
    }

    // 8. Complaints Collection
    match /complaints/{complaintId} {
      allow get: if isVerified() && isValidId(complaintId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(complaintId) && isValidComplaint(incoming()) && (
        (incoming().authUid == request.auth.uid && incoming().status == 'open') || isAdmin()
      );
      allow update: if isAdmin() && isValidId(complaintId) && isValidComplaint(incoming()) && (
        incoming().authUid == existing().authUid &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt'])
      );
      allow delete: if false;
    }

    // 9. Gameplay History (Immutable Once Written)
    match /gameplay_history/{gameId} {
      allow get: if isVerified() && isValidId(gameId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(gameId) && isValidGamePlay(incoming()) && (
        incoming().authUid == request.auth.uid || isAdmin()
      );
      allow update: if false;
      allow delete: if false;
    }

    // 10. Coin Transactions Audit Trail (Immutable Ledger)
    match /coin_transactions/{txId} {
      allow get: if isVerified() && isValidId(txId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isAdmin() && isValidId(txId) && isValidCoinTransaction(incoming());
      allow update: if false;
      allow delete: if false;
    }

    // 11. Activity Sessions
    match /activity_sessions/{sessionId} {
      allow get: if isVerified() && isValidId(sessionId) && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && (existing().authUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(sessionId) && isValidActivitySession(incoming()) && (
        incoming().authUid == request.auth.uid || isAdmin()
      );
      allow update: if isVerified() && isValidId(sessionId) && isValidActivitySession(incoming()) && (
        isAdmin() || (
          existing().authUid == request.auth.uid &&
          incoming().authUid == existing().authUid &&
          incoming().userId == existing().userId &&
          incoming().sessionStart == existing().sessionStart &&
          incoming().diff(existing()).affectedKeys().hasOnly(['lastHeartbeat', 'durationMinutes', 'status'])
        )
      );
      allow delete: if false;
    }
  }
}
